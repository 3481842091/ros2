<?xml version="1.0" ?>
<!--
  空域障碍场景：开阔场地中散布若干不同高度的立柱与方块。

  设计意图：
    · 场地开阔，四旋翼在起点做一次 360 度扫描即可覆盖全部障碍物，
      不会出现"障碍物背后是未知区域"导致规划失败的情况
    · 障碍物高度从 1.2 m 到 3.5 m 不等，迫使路径在垂直方向上也必须绕行，
      从而体现三维（而非二维）寻路的必要性

  坐标约定：
    · 场地沿 +x 方向展开，起飞机位置约在 (0, 0, 2)
    · 目标点设在 (20, 0, 2)
    · 障碍物分布在 x ∈ [4, 19]、y ∈ [-3, 3] 的范围内
-->
<sdf version="1.6">
  <world name="obstacle_course">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.75 0.78 0.82 1</background>
    </scene>

    <!-- ============ 障碍物 ============ -->

    <model name="pillar_1">
      <static>true</static>
      <pose>5 1.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 2.0</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.85 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>6.5 -1.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.25 0.5 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_3">
      <static>true</static>
      <pose>8.5 0.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 1.6 1.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 1.6 1.5</size></box></geometry>
          <material><ambient>0.6 0.55 0.2 1</ambient><diffuse>0.75 0.7 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_4">
      <static>true</static>
      <pose>10.5 2.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 2.5</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.85 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_5">
      <static>true</static>
      <pose>11.5 -2.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.25 0.5 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_6">
      <static>true</static>
      <pose>13.5 0.5 1.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.4 1.4 3.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 1.4 3.5</size></box></geometry>
          <material><ambient>0.6 0.55 0.2 1</ambient><diffuse>0.75 0.7 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_7">
      <static>true</static>
      <pose>15.5 -1.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 2.0 1.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 2.0 1.2</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.85 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_8">
      <static>true</static>
      <pose>17.0 2.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 2.0</size></box></geometry>
          <material><ambient>0.2 0.4 0.7 1</ambient><diffuse>0.25 0.5 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_9">
      <static>true</static>
      <pose>18.5 -0.5 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 1.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 1.2 3.0</size></box></geometry>
          <material><ambient>0.6 0.55 0.2 1</ambient><diffuse>0.75 0.7 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ============ 起终点标记（仅视觉，便于对照） ============ -->

    <model name="start_marker">
      <static>true</static>
      <pose>0 0 2.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.1 0.8 0.1 1</ambient><diffuse>0.15 0.95 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="goal_marker">
      <static>true</static>
      <pose>20 0 2.0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><sphere><radius>0.15</radius></sphere></geometry>
          <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.95 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
